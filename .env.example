# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_DEMO_MODE=true
ALLOW_REAL_PATIENT_DATA=false
ENABLE_EXTERNAL_EMAIL=true
ENABLE_REAL_AI=true

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=HEARTH <notifications@example.com>
# Optional acceptance-test gate after the EMAIL_FROM domain is verified
HEARTH_REQUIRE_INVITE_EMAIL=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Security
DATA_ENCRYPTION_SECRET=
CRON_SECRET=

# Repeatable synthetic launch household (never use for real patient data)
PROVISION_SYNTHETIC_HOUSEHOLD=false
HEARTH_SYNTHETIC_PASSWORD=
