{
  "name": "hearth-care-execution-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:sites": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "test": "npm run test:unit && npm run test:integration && npm run db:check && npm run validate:evidence && npm run validate:holdout && npm run validate:remediation && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/hearth-engine.test.ts tests/hardening.test.ts tests/interpretation-safety.test.ts tests/synthetic-household.test.ts",
    "validate:evidence": "tsx scripts/run-validation.ts",
    "validate:holdout": "tsx scripts/run-holdout.ts",
    "validate:remediation": "tsx scripts/run-remediation.ts",
    "validate:production": "node --env-file=.env.local --import tsx scripts/run-production-acceptance.ts",
    "seed:synthetic": "node --env-file=.env.local --env-file=.env.synthetic.local --import tsx scripts/provision-synthetic-household.ts",
    "validate:accessibility": "node tests/accessibility.audit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:check": "node --test tests/database-schema.test.mjs",
    "test:integration": "tsx --test tests/ai-provider.test.ts tests/persistence-contract.test.ts tests/security-contract.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.25.12",
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "next": {
      "sharp": "0.35.2"
    }
  },
  "type": "module"
}
